{
  "name": "sphinx_shiguredo_theme",
  "version": "2024.1.0",
  "private": true,
  "scripts": {
    "build": "yarn _build/sass && yarn _build/typescript",
    "_build/sass": "npx sass ./src/sass/theme.scss ../sphinx_shiguredo_theme/static/css/theme.css",
    "_build/typescript": "npx rollup -c",
    "lint": "biome lint ./src",
    "fmt": "biome format --write ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-node-resolve": "16.0.1",
    "bootstrap": "5.3.8",
    "normalize.css": "8.0.1",
    "prettier": "3.6.2",
    "rollup": "4.50.2",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-typescript2": "0.36.0",
    "sass": "1.92.1",
    "tslib": "2.8.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.6.0"
}