{
  "name": "sphinx_shiguredo_theme",
  "version": "2022.1.0",
  "private": true,
  "scripts": {
    "build": "yarn _build/sass && yarn _build/typescript",
    "_build/sass": "npx sass ./src/sass/theme.scss ../sphinx_shiguredo_theme/static/css/theme.css",
    "_build/typescript": "npx rollup -c",
    "lint": "biome lint ./src",
    "fmt": "biome format --write ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.2",
    "@rollup/plugin-commonjs": "25.0.7",
    "@rollup/plugin-node-resolve": "15.2.3",
    "bootstrap": "5.3.3",
    "normalize.css": "8.0.1",
    "prettier": "3.3.0",
    "rollup": "4.17.2",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-typescript2": "0.36.0",
    "sass": "1.76.0",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  },
  "packageManager": "pnpm@9.0.6"
}